# Manual Trading Agent — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# OANDA (Execution)
# ---------------------------------------------------------------------------

# OANDA API key for live/paper trading
# Get yours at: https://www.oanda.com/demo-account/tpa/personal_token
OANDA_API_KEY=your_oanda_api_key_here

# OANDA account ID (numeric, found in your OANDA dashboard)
OANDA_ACCOUNT_ID=your_oanda_account_id_here

# ---------------------------------------------------------------------------
# Telegram (Notifications)
# ---------------------------------------------------------------------------

# Telegram bot token for notifications
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID for notifications
# Use @userinfobot or the Telegram API to find your chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------------------------------------------------------------------------
# AI / News (Optional)
# ---------------------------------------------------------------------------

# Optional: Grok AI API key for news fallback (xAI)
# Used when Forex Factory scraping is unavailable
# Leave blank to disable Grok AI news analysis
XAI_API_KEY=

# ---------------------------------------------------------------------------
# ETR Edge Market Terminal (optional)
# ---------------------------------------------------------------------------
# Member login for https://etracademy.com/analisis/{btc,gold,nasdaq,oil}
# Used by `python -m src.cli etr` / etr-scan and Hetzner change-only alerts.
ETRACADEMY_LOGIN=
ETRACADEMY_PASSWORD=
# Optional hard off without removing credentials:
# ETR_ENABLED=false

# ---------------------------------------------------------------------------
# Pre-NY briefing / Hermes (Hetzner)
# ---------------------------------------------------------------------------
# Production compose defaults to host cron as emilio so Hermes CLI works.
# Do not set this to container unless `hermes` is on PATH inside the image.
# BRIEFING_INVOKE=host

