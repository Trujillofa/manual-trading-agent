//@version=6
// Strategy Tester version of the confirmed-HTF-pivot Fib indicator.
//
// Backtest assumptions:
// - Run on a time-based chart below 4H (15-minute recommended for backtest parity).
// - HTF pivots use a one-bar historical offset with lookahead_on. This avoids
//   repainting but intentionally delays each event by one additional HTF bar.
// - Market entries fill on the next bar open under TradingView's default model.
// - Commission is $3/order and slippage is 20 ticks/fill. Configure broker-
//   specific costs and Bar Magnifier in Strategy Properties before relying on a run.
// - TradingView does not model this strategy's spread explicitly.
// - News and session filters remain external because point-in-time news data is
//   not available in this script.
strategy(
    "Confirmed HTF Pivots + Fib + EMA Strategy",
    shorttitle="HTF Fib",
    overlay=true,
    pyramiding=1,
    initial_capital=100000,
    default_qty_type=strategy.fixed,
    default_qty_value=3,
    commission_type=strategy.commission.cash_per_order,
    commission_value=3,
    slippage=20,
    process_orders_on_close=false,
    calc_on_order_fills=false,
    calc_on_every_tick=false,
    max_lines_count=16,
    max_labels_count=8,
    max_boxes_count=4
)

// === Backtest logic ===
string logicMode = input.string(
    "Hardened MTF",
    "Logic Mode",
    options=["Marker Baseline", "Hardened MTF"],
    group="Backtest",
    tooltip=(
        "Marker Baseline preserves the pasted indicator's chart-RSI/EMA200 marker logic. "
        + "Hardened MTF adds confirmed 30m/1h RSI, EMA50/200 alignment, candle confirmation, "
        + "swing invalidation, and at most one trade per confirmed swing."
    )
)
float orderQuantity = input.float(3.0, "Order Quantity", minval=0.01, group="Backtest")
int atrLength = input.int(14, "ATR Length", minval=1, group="Backtest")
float targetAtr = input.float(1.5, "Target ATR", minval=0.1, step=0.1, group="Backtest")
float stopAtr = input.float(1.5, "Stop ATR", minval=0.1, step=0.1, group="Backtest")
int maxHoldBars = input.int(32, "Maximum Hold Bars", minval=1, group="Backtest")
bool enableOrders = input.bool(true, "Enable Strategy Orders", group="Backtest")

// === EMAs ===
int ema50Length = input.int(50, "EMA 50 Length", minval=1, group="EMAs")
int ema200Length = input.int(200, "EMA 200 Length", minval=1, group="EMAs")
bool showEmas = input.bool(true, "Show EMAs", group="EMAs")

// === Confirmed HTF pivots ===
int left4h = input.int(5, "4H Left Bars", minval=1, group="HTF Pivots 4H")
int right4h = input.int(5, "4H Right Bars", minval=1, group="HTF Pivots 4H")
bool show4hLines = input.bool(true, "Show 4H Lines", group="HTF Pivots 4H")
bool show4hLabels = input.bool(false, "Show Latest 4H Labels", group="HTF Pivots 4H")
color color4hHigh = input.color(color.new(color.red, 10), "4H High", group="HTF Pivots 4H")
color color4hLow = input.color(color.new(color.green, 10), "4H Low", group="HTF Pivots 4H")

int leftDaily = input.int(5, "Daily Left Bars", minval=1, group="HTF Pivots Daily")
int rightDaily = input.int(5, "Daily Right Bars", minval=1, group="HTF Pivots Daily")
bool showDailyLines = input.bool(true, "Show Daily Lines", group="HTF Pivots Daily")
bool showDailyLabels = input.bool(false, "Show Latest Daily Labels", group="HTF Pivots Daily")
color colorDailyHigh = input.color(
    color.new(color.maroon, 0),
    "Daily High",
    group="HTF Pivots Daily"
)
color colorDailyLow = input.color(
    color.new(color.lime, 0),
    "Daily Low",
    group="HTF Pivots Daily"
)

// === Fibonacci ===
string fibSource = input.string(
    "4H",
    "Source Timeframe",
    options=["4H", "Daily"],
    group="Fibonacci"
)
bool showFib = input.bool(true, "Show Fib", group="Fibonacci")
bool showFib236 = input.bool(false, "23.6%", group="Fibonacci")
bool showFib382 = input.bool(false, "38.2%", group="Fibonacci")
bool showFib500 = input.bool(true, "50.0%", group="Fibonacci")
bool showFib618 = input.bool(true, "61.8%", group="Fibonacci")
bool showFib786 = input.bool(true, "78.6%", group="Fibonacci")
bool showGoldenZone = input.bool(true, "Shade 61.8%-78.6% Zone", group="Fibonacci")
bool backpaintFib = input.bool(
    false,
    "Start Fib at Swing Endpoint (backpainted)",
    group="Fibonacci",
    tooltip=(
        "OFF starts a Fib when the second pivot becomes confirmed. ON starts it at the "
        + "second pivot's historical bar, where the Fib was not yet knowable."
    )
)

// === Confluence ===
bool showMarkers = input.bool(true, "Show Entry Markers", group="Confluence")
int rsiLength = input.int(14, "RSI Length", minval=2, group="Confluence")
int baselineLongRsi = input.int(
    35,
    "Baseline Long RSI Maximum",
    minval=1,
    maxval=50,
    group="Confluence"
)
int baselineShortRsi = input.int(
    65,
    "Baseline Short RSI Minimum",
    minval=50,
    maxval=99,
    group="Confluence"
)

// === Values table ===
bool showTable = input.bool(false, "Show Values Table", group="Table")

float chartTimeframeSeconds = timeframe.in_seconds()
float fourHourSeconds = timeframe.in_seconds("240")
if barstate.isfirst and (
    na(chartTimeframeSeconds) or chartTimeframeSeconds >= fourHourSeconds
)
    runtime.error("Use on a time-based chart below 4H (15m recommended).")

bool hardened = logicMode == "Hardened MTF"
float ema50 = ta.ema(close, ema50Length)
float ema200 = ta.ema(close, ema200Length)
float rsi15 = ta.rsi(close, rsiLength)
float atr = ta.atr(atrLength)

// Confirmed 30m/1h RSI only. The historical offset prevents incomplete HTF
// candles from leaking final values into earlier 15-minute bars.
float rsi30 = request.security(
    syminfo.tickerid,
    "30",
    ta.rsi(close, rsiLength)[1],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_on
)
float rsi1h = request.security(
    syminfo.tickerid,
    "60",
    ta.rsi(close, rsiLength)[1],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_on
)

f_confirmed_pivot_high(int leftBars, int rightBars) =>
    float pivot = ta.pivothigh(high, leftBars, rightBars)
    [pivot[1], not na(pivot[1]) ? time[rightBars + 1] : int(na)]

f_confirmed_pivot_low(int leftBars, int rightBars) =>
    float pivot = ta.pivotlow(low, leftBars, rightBars)
    [pivot[1], not na(pivot[1]) ? time[rightBars + 1] : int(na)]

[pivot4hHigh, pivot4hHighTime] = request.security(
    syminfo.tickerid,
    "240",
    f_confirmed_pivot_high(left4h, right4h),
    gaps=barmerge.gaps_on,
    lookahead=barmerge.lookahead_on
)
[pivot4hLow, pivot4hLowTime] = request.security(
    syminfo.tickerid,
    "240",
    f_confirmed_pivot_low(left4h, right4h),
    gaps=barmerge.gaps_on,
    lookahead=barmerge.lookahead_on
)
[pivotDailyHigh, pivotDailyHighTime] = request.security(
    syminfo.tickerid,
    "D",
    f_confirmed_pivot_high(leftDaily, rightDaily),
    gaps=barmerge.gaps_on,
    lookahead=barmerge.lookahead_on
)
[pivotDailyLow, pivotDailyLowTime] = request.security(
    syminfo.tickerid,
    "D",
    f_confirmed_pivot_low(leftDaily, rightDaily),
    gaps=barmerge.gaps_on,
    lookahead=barmerge.lookahead_on
)

// === Event deduplication ===
var int seen4hHighTime = na
var int seen4hLowTime = na
var int seenDailyHighTime = na
var int seenDailyLowTime = na

bool new4hHigh = not na(pivot4hHigh) and (
    na(seen4hHighTime) or pivot4hHighTime != seen4hHighTime
)
bool new4hLow = not na(pivot4hLow) and (
    na(seen4hLowTime) or pivot4hLowTime != seen4hLowTime
)
bool newDailyHigh = not na(pivotDailyHigh) and (
    na(seenDailyHighTime) or pivotDailyHighTime != seenDailyHighTime
)
bool newDailyLow = not na(pivotDailyLow) and (
    na(seenDailyLowTime) or pivotDailyLowTime != seenDailyLowTime
)

if new4hHigh
    seen4hHighTime := pivot4hHighTime
if new4hLow
    seen4hLowTime := pivot4hLowTime
if newDailyHigh
    seenDailyHighTime := pivotDailyHighTime
if newDailyLow
    seenDailyLowTime := pivotDailyLowTime

// === Latest-only pivot drawings ===
var line line4hHigh = na
var line line4hLow = na
var line lineDailyHigh = na
var line lineDailyLow = na
var label label4hHigh = na
var label label4hLow = na
var label labelDailyHigh = na
var label labelDailyLow = na

if new4hHigh and show4hLines
    if not na(line4hHigh)
        line.delete(line4hHigh)
    line4hHigh := line.new(
        bar_index,
        pivot4hHigh,
        bar_index + 1,
        pivot4hHigh,
        color=color4hHigh,
        width=2,
        extend=extend.right
    )
if new4hLow and show4hLines
    if not na(line4hLow)
        line.delete(line4hLow)
    line4hLow := line.new(
        bar_index,
        pivot4hLow,
        bar_index + 1,
        pivot4hLow,
        color=color4hLow,
        width=2,
        extend=extend.right
    )
if newDailyHigh and showDailyLines
    if not na(lineDailyHigh)
        line.delete(lineDailyHigh)
    lineDailyHigh := line.new(
        bar_index,
        pivotDailyHigh,
        bar_index + 1,
        pivotDailyHigh,
        color=colorDailyHigh,
        width=2,
        extend=extend.right
    )
if newDailyLow and showDailyLines
    if not na(lineDailyLow)
        line.delete(lineDailyLow)
    lineDailyLow := line.new(
        bar_index,
        pivotDailyLow,
        bar_index + 1,
        pivotDailyLow,
        color=colorDailyLow,
        width=2,
        extend=extend.right
    )

if new4hHigh and show4hLabels
    if not na(label4hHigh)
        label.delete(label4hHigh)
    label4hHigh := label.new(
        bar_index,
        pivot4hHigh,
        "4H H",
        color=color4hHigh,
        textcolor=color.white,
        style=label.style_label_down,
        size=size.tiny
    )
if new4hLow and show4hLabels
    if not na(label4hLow)
        label.delete(label4hLow)
    label4hLow := label.new(
        bar_index,
        pivot4hLow,
        "4H L",
        color=color4hLow,
        textcolor=color.white,
        style=label.style_label_up,
        size=size.tiny
    )
if newDailyHigh and showDailyLabels
    if not na(labelDailyHigh)
        label.delete(labelDailyHigh)
    labelDailyHigh := label.new(
        bar_index,
        pivotDailyHigh,
        "D H",
        color=colorDailyHigh,
        textcolor=color.white,
        style=label.style_label_down,
        size=size.tiny
    )
if newDailyLow and showDailyLabels
    if not na(labelDailyLow)
        label.delete(labelDailyLow)
    labelDailyLow := label.new(
        bar_index,
        pivotDailyLow,
        "D L",
        color=colorDailyLow,
        textcolor=color.white,
        style=label.style_label_up,
        size=size.tiny
    )

// === Directional swing state ===
// Pivot type: 0 = unset, 1 = high, -1 = low.
var int lastPivotType = 0
var float lastPivotPrice = na
var int lastPivotTime = na
var float swingHigh = na
var int swingHighTime = na
var float swingLow = na
var int swingLowTime = na
var int swingDirection = 0
var int swingVersion = 0

var float fib236 = na
var float fib382 = na
var float fib500 = na
var float fib618 = na
var float fib786 = na
bool fibChanged = false

bool sourceHighEvent = fibSource == "4H" ? new4hHigh : newDailyHigh
bool sourceLowEvent = fibSource == "4H" ? new4hLow : newDailyLow
float sourceHighPrice = fibSource == "4H" ? pivot4hHigh : pivotDailyHigh
int sourceHighTime = fibSource == "4H" ? pivot4hHighTime : pivotDailyHighTime
float sourceLowPrice = fibSource == "4H" ? pivot4hLow : pivotDailyLow
int sourceLowTime = fibSource == "4H" ? pivot4hLowTime : pivotDailyLowTime

bool ambiguousSourceEvent = (
    sourceHighEvent
    and sourceLowEvent
    and sourceHighTime == sourceLowTime
)
bool processHighEvent = sourceHighEvent and not sourceLowEvent and not ambiguousSourceEvent
bool processLowEvent = sourceLowEvent and not sourceHighEvent and not ambiguousSourceEvent

if processHighEvent
    if lastPivotType == 0
        lastPivotType := 1
        lastPivotPrice := sourceHighPrice
        lastPivotTime := sourceHighTime
    else if lastPivotType == 1
        if sourceHighPrice > lastPivotPrice
            lastPivotPrice := sourceHighPrice
            lastPivotTime := sourceHighTime
            if swingDirection == 1
                swingHigh := sourceHighPrice
                swingHighTime := sourceHighTime
                float swingRange = swingHigh - swingLow
                if swingRange > 0
                    fib236 := swingHigh - swingRange * 0.236
                    fib382 := swingHigh - swingRange * 0.382
                    fib500 := swingHigh - swingRange * 0.500
                    fib618 := swingHigh - swingRange * 0.618
                    fib786 := swingHigh - swingRange * 0.786
                    fibChanged := true
    else
        float swingRange = sourceHighPrice - lastPivotPrice
        if swingRange > 0
            swingLow := lastPivotPrice
            swingLowTime := lastPivotTime
            swingHigh := sourceHighPrice
            swingHighTime := sourceHighTime
            swingDirection := 1
            fib236 := swingHigh - swingRange * 0.236
            fib382 := swingHigh - swingRange * 0.382
            fib500 := swingHigh - swingRange * 0.500
            fib618 := swingHigh - swingRange * 0.618
            fib786 := swingHigh - swingRange * 0.786
            fibChanged := true
        lastPivotType := 1
        lastPivotPrice := sourceHighPrice
        lastPivotTime := sourceHighTime

if processLowEvent
    if lastPivotType == 0
        lastPivotType := -1
        lastPivotPrice := sourceLowPrice
        lastPivotTime := sourceLowTime
    else if lastPivotType == -1
        if sourceLowPrice < lastPivotPrice
            lastPivotPrice := sourceLowPrice
            lastPivotTime := sourceLowTime
            if swingDirection == -1
                swingLow := sourceLowPrice
                swingLowTime := sourceLowTime
                float swingRange = swingHigh - swingLow
                if swingRange > 0
                    fib236 := swingLow + swingRange * 0.236
                    fib382 := swingLow + swingRange * 0.382
                    fib500 := swingLow + swingRange * 0.500
                    fib618 := swingLow + swingRange * 0.618
                    fib786 := swingLow + swingRange * 0.786
                    fibChanged := true
    else
        float swingRange = lastPivotPrice - sourceLowPrice
        if swingRange > 0
            swingHigh := lastPivotPrice
            swingHighTime := lastPivotTime
            swingLow := sourceLowPrice
            swingLowTime := sourceLowTime
            swingDirection := -1
            fib236 := swingLow + swingRange * 0.236
            fib382 := swingLow + swingRange * 0.382
            fib500 := swingLow + swingRange * 0.500
            fib618 := swingLow + swingRange * 0.618
            fib786 := swingLow + swingRange * 0.786
            fibChanged := true
        lastPivotType := -1
        lastPivotPrice := sourceLowPrice
        lastPivotTime := sourceLowTime

// A confirmed Fib is stale after price breaks its origin. The baseline leaves
// this disabled to preserve the pasted marker behavior.
bool bullishSwingBroken = hardened and swingDirection == 1 and not na(swingLow) and low < swingLow
bool bearishSwingBroken = hardened and swingDirection == -1 and not na(swingHigh) and high > swingHigh
if bullishSwingBroken or bearishSwingBroken
    swingDirection := 0
    swingHigh := na
    swingHighTime := na
    swingLow := na
    swingLowTime := na
    fib236 := na
    fib382 := na
    fib500 := na
    fib618 := na
    fib786 := na
    fibChanged := true

if fibChanged
    swingVersion += 1

// === Fib rendering ===
var line fib236Line = na
var line fib382Line = na
var line fib500Line = na
var line fib618Line = na
var line fib786Line = na
var box goldenZoneBox = na

if fibChanged
    if not na(fib236Line)
        line.delete(fib236Line)
        fib236Line := na
    if not na(fib382Line)
        line.delete(fib382Line)
        fib382Line := na
    if not na(fib500Line)
        line.delete(fib500Line)
        fib500Line := na
    if not na(fib618Line)
        line.delete(fib618Line)
        fib618Line := na
    if not na(fib786Line)
        line.delete(fib786Line)
        fib786Line := na
    if not na(goldenZoneBox)
        box.delete(goldenZoneBox)
        goldenZoneBox := na

    if showFib and swingDirection != 0
        int confirmationTime = time
        int swingEndpointTime = swingDirection == 1 ? swingHighTime : swingLowTime
        int fibStartTime = backpaintFib ? swingEndpointTime : confirmationTime
        int fibEndTime = time_close
        if showFib236
            fib236Line := line.new(
                fibStartTime,
                fib236,
                fibEndTime,
                fib236,
                xloc=xloc.bar_time,
                color=color.new(color.gray, 25),
                extend=extend.right
            )
        if showFib382
            fib382Line := line.new(
                fibStartTime,
                fib382,
                fibEndTime,
                fib382,
                xloc=xloc.bar_time,
                color=color.new(color.blue, 20),
                extend=extend.right
            )
        if showFib500
            fib500Line := line.new(
                fibStartTime,
                fib500,
                fibEndTime,
                fib500,
                xloc=xloc.bar_time,
                color=color.new(color.orange, 10),
                extend=extend.right
            )
        if showFib618
            fib618Line := line.new(
                fibStartTime,
                fib618,
                fibEndTime,
                fib618,
                xloc=xloc.bar_time,
                color=color.new(color.purple, 0),
                width=2,
                extend=extend.right
            )
        if showFib786
            fib786Line := line.new(
                fibStartTime,
                fib786,
                fibEndTime,
                fib786,
                xloc=xloc.bar_time,
                color=color.new(color.red, 10),
                extend=extend.right
            )
        if showGoldenZone
            goldenZoneBox := box.new(
                fibStartTime,
                math.max(fib618, fib786),
                fibEndTime,
                math.min(fib618, fib786),
                xloc=xloc.bar_time,
                border_color=na,
                bgcolor=color.new(color.yellow, 90),
                extend=extend.right
            )

// === Directional confluence ===
bool bullZone = (
    swingDirection == 1
    and not na(fib618)
    and close <= fib618
    and close >= fib786
)
bool bearZone = (
    swingDirection == -1
    and not na(fib618)
    and close >= fib618
    and close <= fib786
)
bool bullishCandle = close > open and close > close[1]
bool bearishCandle = close < open and close < close[1]
bool longRsiOk = hardened ? (
    rsi15 <= 30 and rsi30 <= 30 and rsi1h <= 30
) : rsi15 <= baselineLongRsi
bool shortRsiOk = hardened ? (
    rsi15 >= 70 and rsi30 >= 70 and rsi1h >= 70
) : rsi15 >= baselineShortRsi
bool longTrendOk = hardened ? close > ema50 and ema50 > ema200 : close > ema200
bool shortTrendOk = hardened ? close < ema50 and ema50 < ema200 : close < ema200
bool longCondition = (
    bullZone
    and longTrendOk
    and longRsiOk
    and (not hardened or bullishCandle)
)
bool shortCondition = (
    bearZone
    and shortTrendOk
    and shortRsiOk
    and (not hardened or bearishCandle)
)
bool longTrigger = barstate.isconfirmed and longCondition and not longCondition[1]
bool shortTrigger = barstate.isconfirmed and shortCondition and not shortCondition[1]

var int tradedSwingVersion = na
bool swingAvailable = not hardened or na(tradedSwingVersion) or tradedSwingVersion != swingVersion
float targetTicks = atr * targetAtr / syminfo.mintick
float stopTicks = atr * stopAtr / syminfo.mintick

if enableOrders and strategy.position_size == 0 and swingAvailable
    if longTrigger
        strategy.entry("Long", strategy.long, qty=orderQuantity)
        strategy.exit("Long Exit", "Long", profit=targetTicks, loss=stopTicks)
        tradedSwingVersion := swingVersion
    else if shortTrigger
        strategy.entry("Short", strategy.short, qty=orderQuantity)
        strategy.exit("Short Exit", "Short", profit=targetTicks, loss=stopTicks)
        tradedSwingVersion := swingVersion

var int entryBarIndex = na
bool openedPosition = strategy.position_size != 0 and strategy.position_size[1] == 0
bool closedPosition = strategy.position_size == 0 and strategy.position_size[1] != 0
if openedPosition
    entryBarIndex := bar_index
if strategy.position_size != 0 and not na(entryBarIndex)
    if bar_index - entryBarIndex >= maxHoldBars
        strategy.close_all(comment="Time exit")
if closedPosition
    entryBarIndex := na

plotshape(
    showMarkers and longTrigger and swingAvailable,
    title="Long Fib Setup",
    text="L",
    location=location.belowbar,
    color=color.new(color.green, 0),
    style=shape.triangleup,
    size=size.tiny
)
plotshape(
    showMarkers and shortTrigger and swingAvailable,
    title="Short Fib Setup",
    text="S",
    location=location.abovebar,
    color=color.new(color.red, 0),
    style=shape.triangledown,
    size=size.tiny
)

alertcondition(
    longTrigger and swingAvailable,
    "Long Fib Setup",
    "{{ticker}} {{interval}} - confirmed Fib long setup"
)
alertcondition(
    shortTrigger and swingAvailable,
    "Short Fib Setup",
    "{{ticker}} {{interval}} - confirmed Fib short setup"
)

plot(showEmas ? ema50 : na, "EMA50", color=color.new(color.blue, 0), linewidth=2)
plot(showEmas ? ema200 : na, "EMA200", color=color.new(color.orange, 0), linewidth=2)

var table valuesTable = table.new(
    position.top_right,
    2,
    5,
    bgcolor=color.new(color.black, 90),
    border_width=1
)
if barstate.islast and showTable
    table.cell(valuesTable, 0, 0, "RSI 15m", text_color=color.white, text_size=size.small)
    table.cell(
        valuesTable,
        1,
        0,
        str.tostring(rsi15, "#.00"),
        text_color=color.white,
        text_size=size.small
    )
    table.cell(valuesTable, 0, 1, "RSI 30m", text_color=color.white, text_size=size.small)
    table.cell(
        valuesTable,
        1,
        1,
        str.tostring(rsi30, "#.00"),
        text_color=color.white,
        text_size=size.small
    )
    table.cell(valuesTable, 0, 2, "RSI 1h", text_color=color.white, text_size=size.small)
    table.cell(
        valuesTable,
        1,
        2,
        str.tostring(rsi1h, "#.00"),
        text_color=color.white,
        text_size=size.small
    )
    table.cell(valuesTable, 0, 3, "Swing", text_color=color.white, text_size=size.small)
    table.cell(
        valuesTable,
        1,
        3,
        swingDirection == 1 ? "Bull" : swingDirection == -1 ? "Bear" : "None",
        text_color=swingDirection == 1 ? color.lime : swingDirection == -1 ? color.red : color.gray,
        text_size=size.small
    )
    table.cell(valuesTable, 0, 4, "Mode", text_color=color.white, text_size=size.small)
    table.cell(
        valuesTable,
        1,
        4,
        logicMode,
        text_color=hardened ? color.aqua : color.orange,
        text_size=size.small
    )
